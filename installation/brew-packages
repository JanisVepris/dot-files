#!/bin/bash

OPTIONS=(
    "1password-cli"
    "android-platform-tools"
    "awscli"
    "bat"
    "btop"
    "bun"
    "caddy"
    "colima"
    "composer"
    "curl"
    "delve"
    "docker"
    "docker-compose"
    "dockutil"
    "dust"
    "exiftool"
    "eza"
    "ffmpeg"
    "font-hack-nerd-font"
    "font-monaspace"
    "gd"
    "gh"
    "git"
    "go"
    "icu4c"
    "jless"
    "jq"
    "lazygit"
    "mysql"
    "neovim"
    "node"
    "nss"
    "php-intl"
    "php@8.5"
    "python"
    "redis"
    "ripgrep"
    "speedtest-cli"
    "sqlite"
    "tmux"
    "tree"
    "tree-sitter-cli"
    "uv"
    "watch"
    "wget"
    "zplug"
)

SELECTED=$(selection "🛠️ Select brew packages to install" "${OPTIONS[@]}")

if [[ -z "$SELECTED" ]]; then
    big_message "👍 No packages selected"
    exit 0
fi

for SELECTION in $SELECTED; do
    brew_install "$SELECTION"
done

big_message "✅ Done."
