#!/bin/bash

OPTIONS=(
    "1password"
    "1password-cli"
    "age"
    "arc"
    "elgato-control-center"
    "ghostty"
    "google-chrome"
    "google-drive"
    "insomnia"
    "jetbrains-toolbox"
    "netnewswire"
    "obsidian"
    "raycast"
    "slack"
    "spotify"
    "visual-studio-code"
    "vlc"
    "whatsapp"
)

SELECTED=$(selection "🧩 Select dev tools to install" "${OPTIONS[@]}")

if [[ -z "$SELECTED" ]]; then
    big_message "👍 No apps selected"
    exit 0
fi

for SELECTION in $SELECTED; do
    brew_install_cask "$SELECTION"
done

big_message "✅ Done."

