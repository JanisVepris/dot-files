#!/bin/bash

OPTIONS=(
    "android-platform-tools"
    "awscli"
    "bun"
    "composer"
    "delve"
    "go"
    "icu4c"
    "mysql"
    "node"
    "php-intl"
    "php@8.5"
    "python"
    "redis"
    "sqlite"
)

SELECTED=$(selection "💻 Select dev tools to install" "${OPTIONS[@]}")

if [[ -z "$SELECTED" ]]; then
    big_message "👍 No dev tools selected"
    exit 0
fi

for SELECTION in $SELECTED; do
    brew_install "$SELECTION"
done

big_message "✅ Done."
