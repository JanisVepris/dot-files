#!/bin/bash

function setup_trackpad() {
    defaults write com.apple.AppleMultitouchTrackpad ForceSuppressed -bool true
    defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
    defaults write com.apple.AppleMultitouchTrackpad FirstClickThreshold -int 1
    defaults write com.apple.AppleMultitouchTrackpad SecondClickThreshold -int 1
}

export -f setup_trackpad

if gum confirm "Do you want to apply Trackpad MacOS settings?"; then
    gum spin --spinner dot --title "Applying Trackpad settings" -- bash -c setup_trackpad
    big_message "✅ Trackpad settings applied"
else
    big_message "👍 Skipping Trackpad settings"
fi

