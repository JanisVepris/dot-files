#!/bin/bash

OPTIONS=(
    "1password-cli"
    "dockutil"
    "font-hack-nerd-font"
    "speedtest-cli"
)

SELECTED=$(selection "📦 Select other stuff to install" "${OPTIONS[@]}")

if [[ -z "$SELECTED" ]]; then
    big_message "👍 No packages selected"
    exit 0
fi

for SELECTION in $SELECTED; do
    brew_install "$SELECTION"
done

big_message "✅ Done."

