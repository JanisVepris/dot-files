#!/bin/bash

OPTIONS=(
    "bat"
    "btop"
    "curl"
    "caddy"
    "colima"
    "docker"
    "docker-compose"
    "dust"
    "exiftool"
    "eza"
    "ffmpeg"
    "font-monaspace"
    "fzf"
    "gh"
    "gd"
    "git"
    "gum"
    "jless"
    "jq"
    "lazygit"
    "neovim"
    "nss"
    "ripgrep"
    "tldr"
    "tmux"
    "tree"
    "tree-sitter-cli"
    "uv"
    "watch"
    "wget"
    "zplug"
)

SELECTED=$(selection "🛠️ Select tools to install" "${OPTIONS[@]}")

if [[ -z "$SELECTED" ]]; then
    big_message "👍 No tools selected"
    exit 0
fi

for SELECTION in $SELECTED; do
    brew_install "$SELECTION"
done

big_message "✅ Done."
