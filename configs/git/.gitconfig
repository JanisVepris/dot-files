# This is Git's per-user configuration file.
[user]
	name = Janis Vepris
    email = janis.vepris@gmail.com
[alias]
    lg = log --color --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    rr = reset --hard HEAD
    st = status
    ff = diff
[push]
	default = simple
[pull]
	ff = only
[fetch]
	prune = true
[core]
	autocrlf = input
	excludesfile = /Users/janisvepris/.gitignore_global
