let mapleader=" "

set hlsearch
set incsearch
set ignorecase
set showmode
set showcmd
set smartcase
set surround
set ideamarks
set ideajoin
set highlightedyank
set multiple-cursors

set clipboard=unnamedplus,unnamed

" English in normal
let keep_input_source_in_normal="com.apple.keylayout.ABC"
" set keep-english-in-normal

" disable arrrow keys
nnoremap <Up> <Nop>
nnoremap <Down> <Nop>
nnoremap <Left> <Nop>
nnoremap <Right> <Nop>

nnoremap U u

nnoremap L $
nnoremap H ^
vnoremap L $
vnoremap H ^

" Clean char delete
nnoremap <leader>x "_x
nnoremap <leader>X "_x

" Navigation
nmap <leader>pf <Action>(GotoFile)
" nmap <leader>ps <Action>(GotoSymbol)
nmap <leader>ps <Action>(FileStructurePopup)
nmap <leader>pg <Action>(FindInPath)

" Split
nmap sv <Action>(SplitVertically)

" Surround
xnoremap <leader>s xi ()<Esc>P
xnoremap <leader>s[ xi[]<Esc>P
xnoremap <leader>s] xi[]<Esc>P
xnoremap <leader>s{ xi{}<Esc>P
xnoremap <leader>s} xi{}<Esc>P
xnoremap <leader>s' xi''<Esc>P
xnoremap <leader>s" xi""<Esc>P

" Refactoring
map <leader>rr <Action>(RenameElement)
map <leader>RR <Action>(Refactorings.QuickListPopupAction)

vnoremap <leader>P "\"_dP

vnoremap ii aBoVk

map ]] <Action>(GotoNextError)
map [[ <Action>(GotoPreviousError)
