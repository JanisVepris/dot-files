      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(flox activate:*)",
      "Bash(gh pr *)",
      "Bash(git -C /Users/janisvepris/code/saltz status --short)",
      "Bash(git add:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git cat-file:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git config --local --get:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
