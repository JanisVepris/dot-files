      "Bash(git restore:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git submodule status:*)",
      "Bash(git submodule summary:*)",
      "Bash(git switch:*)",
      "Bash(git worktree *)",
      "Bash(grep -E:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ln -s ../../node_modules node_modules)",
      "Bash(ls nova-components/SaltzWarehouse/package.json)",
      "Bash(ls package.json composer.json)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(where:*)",
      "Bash(which:*)",
      "Bash(xargs sed *)",
      "Bash(xargs sed *)",
      "Skill(superpowers:systematic-debugging)",
      "Skill(testing-php-phpunit)",
      "WebFetch(domain:betterstack.com)",
      "WebSearch",
      "mcp__sentry",
      "mcp__betterstack",
      "mcp__plugin_roboflow_roboflow"
    ],
    "deny": [
      "Read(**/*.aes)",
      "Read(**/*.age)",
      "Read(**/*.argon2)",
      "Read(**/*.bcrypt)",
      "Read(**/*.cert)",
      "Read(**/*.crt)",
      "Read(**/*.gpg)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.pgp)",
      "Read(**/*.scrypt)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.env.production)",
      "Read(**/.ssh/*)",
      "Read(~/.aws/**)"
    ],
    "ask": [
      "Bash(az:*)",
      "Bash(chmod 777:*)",
      "Bash(curl:*)",
      "Bash(eval:*)",
      "Bash(git clean -fd:*)",
      "Bash(git pull:*)",
      "Bash(git push --force:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Bash(wget:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/janisvepris/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
