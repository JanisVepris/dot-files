{
  "cleanupPeriodDays": 7,
  "env": {
    "COLORTERM": "truecolor",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(awk '{print $1}')",
      "Bash(awk -F'extends ' '{print $2}')",
      "Bash(cat:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(flox activate:*)",
      "Bash(flox activate:*)",
      "Bash(gh pr *)",
      "Bash(git -C /Users/janisvepris/code/saltz status --short)",
      "Bash(git add:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git cat-file:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git config --local --get:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git remote -v:*)",
      "Bash(git restore:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git submodule status:*)",
      "Bash(git submodule summary:*)",
      "Bash(git switch:*)",
      "Bash(git worktree *)",
      "Bash(grep -E:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ln -s ../../node_modules node_modules)",
      "Bash(ls nova-components/SaltzWarehouse/package.json)",
      "Bash(ls package.json composer.json)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(where:*)",
      "Bash(which:*)",
      "Bash(xargs sed *)",
      "Skill(superpowers:systematic-debugging)",
      "Skill(testing-php-phpunit)",
      "WebFetch(domain:betterstack.com)",
      "WebSearch",
      "Bash(awk '{print $1}')",
      "Bash(awk -F'extends ' '{print $2}')",
      "Bash(flox activate:*)",
      "Bash(gh pr *)",
      "Bash(git -C /Users/janisvepris/code/saltz status --short)",
      "Bash(git worktree *)",
      "Bash(ln -s ../../node_modules node_modules)",
      "Bash(ls nova-components/SaltzWarehouse/package.json)",
      "Bash(ls package.json composer.json)",
      "Bash(xargs sed *)"
    ],
    "deny": [
      "Read(**/.env.production)",
      "Read(**/*.aes)",
      "Read(**/*.age)",
      "Read(**/*.argon2)",
      "Read(**/*.bcrypt)",
      "Read(**/*.gpg)",
      "Read(**/*.pgp)",
      "Read(**/*.scrypt)",
      "Read(**/*.cert)",
      "Read(**/*.crt)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.ssh/*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)",
      "Bash(az:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "phpstorm-plugin@phpstorm-marketplace": true,
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "preferredNotifChannel": "ghostty"
