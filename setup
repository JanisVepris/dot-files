#!/bin/bash

source ./configs/zsh/.zshenv

if ! command -v brew &> /dev/null
then
    echo "📦 Homebrew is not installed. Please install Homebrew first. https://brew.sh/"
    echo "Run this to install Homebrew:"
    echo '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
    exit 1
fi

if ! command -v gum &> /dev/null
then
    echo "📦 Gum is not installed. Installing gum..."
    brew install gum
    echo "📦 Gum installed. Please run the script again."
    exit
fi

big_message "🚀 Starting setup"

if ! command -v fzf &> /dev/null
then
    big_message "📦 Fzf is not installed. Installing fzf..."
    brew_install fzf
    big_message "📦 Fzf installed. Please run the script again."
    exit
fi

./installation/dock
./installation/trackpad
./installation/keyboard
./installation/tooling
./installation/dev
./installation/other
./installation/apps
./installation/ui

gum spin \
    --spinner dot \
    --title "🧹 Cleaning up" \
    -- brew cleanup

big_message "🎉 Setup complete 🎉"

