#!/bin/bash
#
# Links every config in this repo into $HOME. Safe to run again.
# A real file or folder in the way is moved to <name>.backup first.

source $HOME/dot-files/configs/zsh/.zshenv

while read -r from to; do
    [[ -z $from ]] && continue

    target=$HOME/$to
    mkdir -p "$(dirname "$target")"

    if [[ -e $target && ! -L $target ]]; then
        mv "$target" "$target.backup"
    fi

    ln -sfn "$DOT_FILES_DIR/$from" "$target"
done <<'EOF'
configs/zsh/.zshenv                     .zshenv
configs/zsh/.zshrc                      .zshrc
configs/zsh/janis.zsh-theme             .oh-my-zsh/custom/themes/janis.zsh-theme
configs/git/.gitconfig                  .gitconfig
configs/git/.gitconfig-work             .gitconfig-work
configs/git/.gitignore_global           .gitignore_global
configs/ssh/config                      .ssh/config
configs/ghostty                         .config/ghostty
configs/nvim                            .config/nvim
configs/ideavim/.ideavimrc              .ideavimrc
configs/bat/config                      .config/bat/config
configs/claude/settings.json            .claude/settings.json
configs/claude/statusline-command.sh    .claude/statusline-command.sh
configs/claude/output-styles/eli5.md    .claude/output-styles/eli5.md
configs/claude/CLAUDE.md                .claude/CLAUDE.md
configs/aerospace/aerospace.toml        .config/aerospace/aerospace.toml
configs/borders/bordersrc               .config/borders/bordersrc
extra/.hushlogin                        .hushlogin
EOF

if [[ ! -f $HOME/.zshenv_private ]]; then
    cp $DOT_FILES_DIR/extra/.zshenv_private.example $HOME/.zshenv_private

    big_message "👍 Created empty ~/.zshenv_private file. Please fill it with your private environment variables."
fi

big_message "✅ Configs linked"
